#!/usr/bin/env node

const DEFAULT_URL = process.env.CODEBURG_URL || "http://127.0.0.1:8080";
const DEFAULT_MODE = process.env.CODEBURG_TASK_MODE || "auto";

function usage() {
  console.error(`Usage:
  codeburg-task projects [--json] [--mode auto|internal|public] [--url URL] [--token TOKEN | --password PASSWORD]
  codeburg-task create --project ID_OR_NAME --title TITLE [--description TEXT] [--dedupe] [--json] [--mode auto|internal|public] [--url URL] [--token TOKEN | --password PASSWORD]

Modes:
  - auto (default): try internal loopback API first, then fallback to public API
  - internal: use /api/internal/agent/* only (no auth token required)
  - public: use normal /api/* endpoints (requires token or password)

Auth (public mode):
  - Set CODEBURG_TOKEN (recommended), or
  - pass --token, or
  - pass --password / set CODEBURG_PASSWORD (uses /api/auth/login)
`);
}

function parseArgs(argv) {
  const result = {
    command: null,
    args: [],
    opts: {
      url: DEFAULT_URL,
      mode: DEFAULT_MODE,
      token: process.env.CODEBURG_TOKEN || "",
      password: process.env.CODEBURG_PASSWORD || "",
      json: false,
      dedupe: false,
      project: "",
      title: "",
      description: "",
    },
  };

  if (argv.length === 0) {
    return result;
  }

  result.command = argv[0];

  for (let i = 1; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--url") {
      i += 1;
      result.opts.url = argv[i] || "";
    } else if (arg === "--mode") {
      i += 1;
      result.opts.mode = argv[i] || "";
    } else if (arg === "--token") {
      i += 1;
      result.opts.token = argv[i] || "";
    } else if (arg === "--password") {
      i += 1;
      result.opts.password = argv[i] || "";
    } else if (arg === "--json") {
      result.opts.json = true;
    } else if (arg === "--dedupe") {
      result.opts.dedupe = true;
    } else if (arg === "--project") {
      i += 1;
      result.opts.project = argv[i] || "";
    } else if (arg === "--title") {
      i += 1;
      result.opts.title = argv[i] || "";
    } else if (arg === "--description") {
      i += 1;
      result.opts.description = argv[i] || "";
    } else {
      result.args.push(arg);
    }
  }

  return result;
}

async function loginWithPassword(baseUrl, password) {
  const resp = await fetch(`${baseUrl}/api/auth/login`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ password }),
  });

  if (!resp.ok) {
    const text = await resp.text();
    throw new Error(`login failed (${resp.status}): ${text}`);
  }

  const data = await resp.json();
  if (!data || typeof data.token !== "string" || data.token.length === 0) {
    throw new Error("login response did not include token");
  }
  return data.token;
}

function ensureArray(data) {
  if (Array.isArray(data)) return data;
  if (data && Array.isArray(data.items)) return data.items;
  if (data && Array.isArray(data.tasks)) return data.tasks;
  if (data && Array.isArray(data.projects)) return data.projects;
  return [];
}

async function apiCall(baseUrl, token, method, path, body) {
  const headers = { Accept: "application/json" };
  if (body !== undefined) {
    headers["Content-Type"] = "application/json";
  }
  if (token) {
    headers.Authorization = `Bearer ${token}`;
  }

  const resp = await fetch(`${baseUrl}${path}`, {
    method,
    headers,
    body: body === undefined ? undefined : JSON.stringify(body),
  });

  const contentType = resp.headers.get("content-type") || "";
  let data = null;
  if (contentType.includes("application/json")) {
    data = await resp.json();
  } else {
    data = await resp.text();
  }

  if (!resp.ok) {
    const text = typeof data === "string" ? data : JSON.stringify(data);
    const err = new Error(`${method} ${path} failed (${resp.status}): ${text}`);
    err.status = resp.status;
    throw err;
  }

  return data;
}

function printProjects(projects) {
  if (projects.length === 0) {
    console.log("No projects found.");
    return;
  }

  console.log("ID\tNAME\tPATH");
  for (const project of projects) {
    const id = project?.id || "";
    const name = project?.name || "";
    const path = project?.path || "";
    console.log(`${id}\t${name}\t${path}`);
  }
}

function printCreateResult(payload, opts) {
  if (opts.json) {
    console.log(JSON.stringify(payload, null, 2));
    return;
  }

  const projectName = payload?.project?.name || payload?.project?.id || "";
  const taskId = payload?.task?.id || "";
  const taskTitle = payload?.task?.title || opts.title;

  if (payload?.deduped) {
    console.log(`Deduped: existing task ${taskId} (${taskTitle}) in ${projectName}`);
    return;
  }

  console.log(`Created task ${taskId} in ${projectName}: ${taskTitle}`);
}

function shouldFallbackToPublic(err) {
  if (!err || typeof err.status !== "number") return false;
  return err.status === 401 || err.status === 403 || err.status === 404;
}

async function getPublicToken(baseUrl, opts) {
  let token = opts.token;
  if (!token && opts.password) {
    token = await loginWithPassword(baseUrl, opts.password);
  }
  if (!token) {
    throw new Error(
      "public API auth is required (set CODEBURG_TOKEN, or pass --token/--password)"
    );
  }
  return token;
}

async function listProjectsInternal(baseUrl, opts) {
  const data = await apiCall(baseUrl, "", "GET", "/api/internal/agent/projects");
  const projects = ensureArray(data);
  if (opts.json) {
    console.log(JSON.stringify(projects, null, 2));
  } else {
    printProjects(projects);
  }
}

async function listProjectsPublic(baseUrl, opts) {
  const token = await getPublicToken(baseUrl, opts);
  const data = await apiCall(baseUrl, token, "GET", "/api/projects");
  const projects = ensureArray(data);
  if (opts.json) {
    console.log(JSON.stringify(projects, null, 2));
  } else {
    printProjects(projects);
  }
}

async function createTaskInternal(baseUrl, opts) {
  if (!opts.project) {
    throw new Error("--project is required");
  }
  if (!opts.title) {
    throw new Error("--title is required");
  }

  const payload = {
    project: opts.project,
    title: opts.title,
    description: opts.description,
    dedupe: opts.dedupe,
  };

  const result = await apiCall(baseUrl, "", "POST", "/api/internal/agent/tasks", payload);
  printCreateResult(result, opts);
}

function normalize(s) {
  return (s || "").trim().toLowerCase();
}

function resolveProject(projects, selector) {
  const sel = (selector || "").trim();
  if (!sel) return null;

  const byId = projects.find((p) => p && p.id === sel);
  if (byId) return byId;

  const lowered = sel.toLowerCase();
  const exact = projects.filter((p) => {
    const name = (p && typeof p.name === "string" ? p.name : "").toLowerCase();
    const path = (p && typeof p.path === "string" ? p.path : "").toLowerCase();
    return name === lowered || path === lowered;
  });
  if (exact.length === 1) return exact[0];
  if (exact.length > 1) {
    throw new Error(`project selector '${selector}' matched multiple projects`);
  }

  const fuzzy = projects.filter((p) => {
    const name = (p && typeof p.name === "string" ? p.name : "").toLowerCase();
    const path = (p && typeof p.path === "string" ? p.path : "").toLowerCase();
    return name.includes(lowered) || path.includes(lowered);
  });
  if (fuzzy.length === 1) return fuzzy[0];
  if (fuzzy.length > 1) {
    throw new Error(`project selector '${selector}' matched multiple projects`);
  }

  return null;
}

async function createTaskPublic(baseUrl, opts) {
  if (!opts.project) {
    throw new Error("--project is required");
  }
  if (!opts.title) {
    throw new Error("--title is required");
  }

  const token = await getPublicToken(baseUrl, opts);

  const projectData = await apiCall(baseUrl, token, "GET", "/api/projects");
  const projects = ensureArray(projectData);
  const project = resolveProject(projects, opts.project);
  if (!project || !project.id) {
    throw new Error(`project '${opts.project}' not found`);
  }

  if (opts.dedupe) {
    const taskData = await apiCall(
      baseUrl,
      token,
      "GET",
      `/api/tasks?project=${encodeURIComponent(project.id)}`
    );
    const tasks = ensureArray(taskData);
    const incoming = normalize(opts.title);
    const existing = tasks.find((t) => normalize(t?.title) === incoming);
    if (existing) {
      printCreateResult(
        {
          deduped: true,
          task: existing,
          project: { id: project.id, name: project.name || "" },
        },
        opts
      );
      return;
    }
  }

  const payload = { title: opts.title };
  if (opts.description) {
    payload.description = opts.description;
  }

  const created = await apiCall(
    baseUrl,
    token,
    "POST",
    `/api/projects/${encodeURIComponent(project.id)}/tasks`,
    payload
  );

  printCreateResult(
    {
      deduped: false,
      task: created,
      project: { id: project.id, name: project.name || "" },
    },
    opts
  );
}

async function runProjects(baseUrl, opts) {
  if (opts.mode === "internal") {
    await listProjectsInternal(baseUrl, opts);
    return;
  }
  if (opts.mode === "public") {
    await listProjectsPublic(baseUrl, opts);
    return;
  }

  try {
    await listProjectsInternal(baseUrl, opts);
    return;
  } catch (err) {
    if (!shouldFallbackToPublic(err)) {
      throw err;
    }
  }

  await listProjectsPublic(baseUrl, opts);
}

async function runCreate(baseUrl, opts) {
  if (opts.mode === "internal") {
    await createTaskInternal(baseUrl, opts);
    return;
  }
  if (opts.mode === "public") {
    await createTaskPublic(baseUrl, opts);
    return;
  }

  try {
    await createTaskInternal(baseUrl, opts);
    return;
  } catch (err) {
    if (!shouldFallbackToPublic(err)) {
      throw err;
    }
  }

  await createTaskPublic(baseUrl, opts);
}

async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  if (!parsed.command || parsed.command === "help" || parsed.command === "--help") {
    usage();
    process.exit(parsed.command ? 0 : 1);
  }

  const baseUrl = (parsed.opts.url || "").replace(/\/+$/, "");
  if (!baseUrl) {
    throw new Error("Codeburg URL is required (--url or CODEBURG_URL)");
  }

  const mode = parsed.opts.mode;
  if (!["auto", "internal", "public"].includes(mode)) {
    throw new Error("invalid --mode (expected auto, internal, or public)");
  }

  if (parsed.command === "projects") {
    await runProjects(baseUrl, parsed.opts);
    return;
  }

  if (parsed.command === "create") {
    await runCreate(baseUrl, parsed.opts);
    return;
  }

  throw new Error(`unknown command: ${parsed.command}`);
}

main().catch((err) => {
  console.error(`codeburg-task error: ${err.message}`);
  process.exit(1);
});
