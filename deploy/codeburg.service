[Unit]
Description=Codeburg Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codeburg
Group=codeburg
WorkingDirectory=/opt/codeburg
ExecStart=/opt/codeburg/backend/codeburg serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
KillMode=process
Environment=HOME=/home/codeburg
Environment=TERM=xterm-256color
Environment=PATH=/home/codeburg/.local/bin:/home/codeburg/go/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=NPM_CONFIG_PREFIX=/home/codeburg/.local
Environment=npm_config_prefix=/home/codeburg/.local
Environment=NODE_PATH=/home/codeburg/.local/lib/node_modules

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/codeburg
ReadWritePaths=/opt/codeburg
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
